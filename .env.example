# =================================================================
# SkillForge LMS - Root Environment Variables Template (.env.example)
# Copy this file to .env and supply your environment-specific credentials
# =================================================================

# Server & Application
SERVER_PORT=8080
APP_NAME=SkillForge
APP_BASE_URL=http://localhost:5173
APP_API_BASE_URL=http://localhost:8080/api
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/skillforge_lms
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# Security (JWT) - Must be a random secret of at least 256 bits (32+ characters)
JWT_SECRET=YOUR_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_HMAC_SHA256
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false

# Bootstrap Administrator (Used on first startup to initialize the admin account)
ADMIN_BOOTSTRAP_EMAIL=admin@skillforge.com
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword2026!

# Payment Gateway - Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere
RAZORPAY_CURRENCY=INR

# Private Cloud Storage - AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=skillforge-lms
S3_URL_EXPIRY_MINUTES=60

# Transactional Email - Gmail SMTP / Resend (https://resend.com)
EMAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=SkillForge Academy

# SMS OTP Provider - MSG91 (https://msg91.com)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=YourMsg91AuthKeyHere
MSG91_TEMPLATE_ID=YourMsg91OtpTemplateIdHere
MSG91_SENDER_ID=SKLFRG
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Official WhatsApp Business Platform Cloud API (Meta for Developers)
WHATSAPP_ACCESS_TOKEN=YourMetaCloudApiAccessTokenHere
WHATSAPP_PHONE_NUMBER_ID=YourWhatsAppPhoneNumberIdHere
WHATSAPP_API_VERSION=v18.0
WHATSAPP_VERIFY_TOKEN=YourWebhookVerificationTokenHere

# Certificate Branding & Signatory
CERT_COMPANY_NAME=SkillForge Academy
CERT_SIGNATORY_NAME=Dr. Vikram Sen
CERT_SIGNATORY_TITLE=Director of Academic Standards
